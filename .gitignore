# ==========================================
# Pastify - Git Ignore Rules
# ==========================================

# 1. Data & Media (NEVER track these due to size and privacy)
output_questions/
split_papers.log
*.bak_*

# 2. Python Cache & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.env

# 3. OS Generated Files (Mac/Windows junk)
.DS_Store
.DS_Store?
.DS_Store
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 4. Streamlit specific
.streamlit/secrets.toml
progress.db
github_release_archives/

# 5. MCQ Splitter - generated outputs and development backups
mcq_*test*/
mcq_full_test_*/
mcq_*_report.csv
mcq_*_audit.txt
mcq_splitter_v*_backup.py

# Pastify local development exclusions

# Historical local archives and backups
/archive/
*.zip

# Local database snapshots (existing tracked databases are unaffected)
*_backup.db
*_preview.db
past_papers_before_*.db
past_papers_recovered.db
pastify_mcq_*.db

# Generated extraction datasets and reports
/Pastify Workspace/
pastify_mcq_*staging/
pastify_mcq_*backup/
batch_report.csv
excluded_sources.txt
unmatched_sources.txt
*_audit.csv
*_audit_summary.txt

# Local production migration backups
.pastify_production_backup_*/
